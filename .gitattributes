textAssets/catalog.sqlite.zip filter=lfs diff=lfs merge=lfs -text
textAssets/localization/*.jsonl filter=lfs diff=lfs merge=lfs -text
textAssets/by-role/*.jsonl filter=lfs diff=lfs merge=lfs -text

# Generated modules and package text must be reproducible on Windows clones.
*.lua text eol=lf
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.tsv text eol=lf
*.ini text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.dll binary
*.wav binary

# Fragment separators and third-party notices preserve their original text.
modules/FlAccessReader/engine/*.lua whitespace=-blank-at-eof
modules/FlAccessGameplay/FlAccessGameplay.lua -text whitespace=cr-at-eol
modules/FlAccessGameplay/COPYING.OpenAL -text whitespace=-blank-at-eol,-blank-at-eof
**/licenses/** -text whitespace=-blank-at-eol,-blank-at-eof

*.snippet text eol=lf
